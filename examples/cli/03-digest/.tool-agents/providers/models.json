{
  "agents": [
    {
      "name": "worker",
      "provider": {
        "type": "openrouter",
        "model": "qwen/qwen-2.5-7b-instruct",
        "api_key_env": "OPENROUTER_API_KEY",
        "settings": {
          "temperature": 0.2
        },
        "timeout": 120,
        "max_retries": 1,
        "extra_settings": {
          "max_tokens": 1200
        }
      }
    },
    {
      "name": "stylist",
      "provider": {
        "type": "openrouter",
        "model": "qwen/qwen-2.5-7b-instruct",
        "api_key_env": "OPENROUTER_API_KEY",
        "settings": {
          "temperature": 0.8
        },
        "timeout": 120,
        "max_retries": 1,
        "extra_settings": {
          "max_tokens": 1200
        }
      }
    }
  ],
  "default_agent": "worker"
}
